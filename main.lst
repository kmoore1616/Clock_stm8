      0005F1 72 11 00 53      [ 1]  733 	BRES	0x53,#0
      0005F5 72 13 00 53      [ 1]  734 	BRES	0x53,#1
      0005F9 72 15 00 53      [ 1]  735 	BRES	0x53,#2
                                    736 ;CALL	ClockMode
      0005FD 81               [ 4]  737 	RET
      0005FE                        738 MakeBeep:
      0005FE 72 0F 00 53 05   [ 2]  739 	BTJF	0x53,#7,SkipBeep
      000603 90 18 50 0F      [ 1]  740 	BCPL	0x500F, #4 ; Toggle Port D, Pin 4 (Creates 500Hz Tone)
      000607 81               [ 4]  741 	RET
      000608                        742 SkipBeep:
      000608 72 19 50 0F      [ 1]  743 	BRES	0x500F,#4
      00060C 81               [ 4]  744 	RET
      00060D                        745 DumbDelay:
      00060D 89               [ 2]  746 	PUSHW	X
      00060E AE FF FF         [ 2]  747 	LDW	X, #0xFFFF
      000611                        748 DumbLoop:
      000611 5A               [ 2]  749 	DECW	X
      000612 27 03            [ 1]  750 	JREQ	DumbDone
      000614 CCr06r11         [ 2]  751 	JP	DumbLoop
      000617                        752 DumbDone:
      000617 85               [ 2]  753 	POPW	X
      000618 81               [ 4]  754 	RET
                                    755 ;	main.c: 756: }
      000619 81               [ 4]  756 	ret
