      000361 72 0E 50 0B 3C   [ 2]  430 	BTJT	0x500B,#7,SkipAlmMov ; Is move button pressed?
      000366 72 03 00 52 37   [ 2]  431 	BTJF	0x52,#1,SkipAlmMov
      00036B 72 05 00 52 32   [ 2]  432 	BTJF	0x52,#2,SkipAlmMov
      000370 72 13 00 52      [ 1]  433 	BRES	0x52,#1
      000374 72 15 00 52      [ 1]  434 	BRES	0x52,#2
